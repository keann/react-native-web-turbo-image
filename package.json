    "tsdown": "0.23.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native-web": ">=0.19"
  },
  "packageManager": "bun@1.4.4-canary.20261030.1"
