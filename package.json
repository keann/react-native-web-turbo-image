    "blurhash": "2.0.5",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "@keann/lint-config": "1.0.0",
    "@storybook/addon-vitest": "11.0.0-alpha.8",
    "@storybook/react-vite": "11.0.0-alpha.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-native-web": "0.19.3",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.14.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-turbo-image-upstream": "npm:react-native-turbo-image@1.24.3",
